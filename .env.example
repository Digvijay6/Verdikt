# Copy to backend/.env and frontend/.env.local as appropriate.
# Never commit real values.

# --- Supabase ---
# Settings -> API Keys in the dashboard.
SUPABASE_URL=https://xxxx.supabase.co
# "Secret key" (sb_secret_...), formerly service_role. Bypasses every security
# rule — server only, never in a VITE_ variable.
SUPABASE_SERVICE_KEY=
# Legacy HS256 secret. LEAVE BLANK on a new project: those sign tokens with
# ES256 and are verified against the JWKS endpoint automatically. Only fill
# this if your project still issues HS256 tokens.
SUPABASE_JWT_SECRET=

# --- Gemini ---
GEMINI_API_KEY=

# --- LiveKit ---
LIVEKIT_URL=wss://xxxx.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Email ---
# resend = the real path. smtp = Gmail fallback, for use until a sending
# domain is verified. Unverified Resend only delivers to the account owner's
# own address, which is fine for development and useless for a demo.
# Either way, if the chosen provider refuses an address the other is tried.
EMAIL_PROVIDER=resend

RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev

# Gmail needs 2FA enabled and an app-specific password:
# myaccount.google.com/apppasswords. The account password will not work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
SMTP_FROM=

# --- App ---
APP_BASE_URL=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
INVITE_TTL_HOURS=168
INTERVIEW_REJOIN_WINDOW_MINUTES=60

# --- Frontend (VITE_ prefix is exposed to the browser — anon key only) ---
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://xxxx.supabase.co
# "Publishable key" (sb_publishable_...), formerly anon. Public by design.
VITE_SUPABASE_ANON_KEY=
