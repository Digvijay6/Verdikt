# Copy to backend/.env and frontend/.env.local as appropriate.
# Never commit real values.

# --- Supabase ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=            # server only, bypasses RLS, never ship to browser
SUPABASE_JWT_SECRET=             # verifies recruiter JWTs

# --- Gemini ---
GEMINI_API_KEY=

# --- LiveKit ---
LIVEKIT_URL=wss://xxxx.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Email ---
RESEND_API_KEY=
FROM_EMAIL=interviews@verdikt.app

# --- App ---
APP_BASE_URL=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
INVITE_TTL_HOURS=168
INTERVIEW_REJOIN_WINDOW_MINUTES=60

# --- Frontend (VITE_ prefix is exposed to the browser — anon key only) ---
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
